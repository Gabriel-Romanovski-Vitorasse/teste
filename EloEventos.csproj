<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EloEventos</RootNamespace>
    <AssemblyName>EloEventos</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Renderiza os SVGs exportados do Figma sem redesenhá-los. -->
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.4" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="Assets\**\*.svg;Assets\**\*.png;Assets\**\*.jpg" />
  </ItemGroup>

  <!-- Assets exportados do Figma (links temporários, válidos por 7 dias).
       Baixados automaticamente antes da compilação quando ainda não existem. -->
  <Import Project="FigmaAssets.targets" />

</Project>
