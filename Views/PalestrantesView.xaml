<UserControl x:Class="EloEventos.Views.PalestrantesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EloEventos.Controls">

    <c:SpacedStackPanel Spacing="24">

        <!-- Cabeçalho da página -->
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="+ Novo palestrante"
                    VerticalAlignment="Center" Margin="24,0,0,0" Click="Novo_Click" />
            <StackPanel>
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="Vozes que inspiram novas ideias." />
                <TextBlock Style="{StaticResource Text.14}" Foreground="{StaticResource Brush.Muted}" Margin="0,6,0,0"
                           Text="Reúna especialistas, vincule aos eventos e reconheça cada contribuição." />
            </StackPanel>
        </DockPanel>

        <!-- Resumo -->
        <StackPanel Orientation="Horizontal">
            <c:StatusPill x:Name="ResumoTotal" Kind="Info" Text="18 palestrantes" />
            <c:StatusPill Kind="Neutral" Text="8 especialidades" Margin="12,0,0,0" />
            <c:StatusPill x:Name="ResumoCertificados" Kind="Success" Text="5 certificados emitidos" Margin="12,0,0,0" />
        </StackPanel>

        <!-- Diretório e cadastro -->
        <DockPanel>
            <!-- Cadastro do palestrante -->
            <c:SpacedStackPanel DockPanel.Dock="Right" Width="420" Margin="24,0,0,0" Spacing="20">
                <Border Style="{StaticResource Card}">
                    <c:SpacedStackPanel Spacing="20">
                        <c:SectionHeader x:Name="FormTitulo" Title="Cadastro do palestrante" Subtitle="Editando Marina Alves" />
                        <c:Field Label="ID">
                            <TextBox x:Name="CampoId" Style="{StaticResource Input}" IsReadOnly="True" />
                        </c:Field>
                        <c:Field Label="Nome completo *">
                            <TextBox x:Name="CampoNome" Style="{StaticResource Input}" />
                        </c:Field>
                        <c:Field Label="CPF *">
                            <TextBox x:Name="CampoCpf" Style="{StaticResource Input}" Tag="000.000.000-00" />
                        </c:Field>
                        <c:Field Label="E-mail *">
                            <TextBox x:Name="CampoEmail" Style="{StaticResource Input}" />
                        </c:Field>
                        <c:Field Label="Especialidade *">
                            <TextBox x:Name="CampoEspecialidade" Style="{StaticResource Input}" />
                        </c:Field>
                        <c:Field Label="Minibiografia *">
                            <TextBox x:Name="CampoBio" Style="{StaticResource Input.Multiline}" />
                        </c:Field>
                        <TextBlock Style="{StaticResource Text.11}" Text="CPF fictício para demonstração. Não utilize documentos reais." />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Secondary}" Content="Cancelar" Click="Cancelar_Click" />
                            <Button Style="{StaticResource Button.Primary}" Content="Salvar cadastro" Margin="12,0,0,0" Click="Salvar_Click" />
                        </StackPanel>
                        <TextBlock x:Name="Erro" Style="{StaticResource Text.12}" Foreground="{StaticResource Brush.Danger}"
                                   Visibility="Collapsed" />
                    </c:SpacedStackPanel>
                </Border>

                <c:Notice x:Name="AvisoVinculo"
                          Text="Marina está vinculada ao Conecta 2026. A minibiografia será exibida nos detalhes do evento." />
            </c:SpacedStackPanel>

            <!-- Diretório -->
            <c:SpacedStackPanel Spacing="18">
                <DockPanel>
                    <ComboBox x:Name="FiltroArea" DockPanel.Dock="Right" Style="{StaticResource Select.Filter}"
                              Margin="12,0,0,0" SelectionChanged="Filtro_Changed" />
                    <TextBox x:Name="Busca" Style="{StaticResource SearchBox}" Tag="Buscar por nome ou especialidade"
                             TextChanged="Busca_Changed" />
                </DockPanel>

                <Border Style="{StaticResource Table}">
                    <StackPanel>
                        <Border Style="{StaticResource Table.Header}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,3,0,0">
                                <TextBlock Style="{StaticResource Text.TableHeader}" Width="265" Text="PALESTRANTE" />
                                <TextBlock Style="{StaticResource Text.TableHeader}" Width="190" Text="ESPECIALIDADE" />
                                <TextBlock Style="{StaticResource Text.TableHeader}" Width="85" Text="ID" />
                                <TextBlock Style="{StaticResource Text.TableHeader}" Width="65" Text="EVENTOS" />
                            </StackPanel>
                        </Border>
                        <ListBox x:Name="Lista" Style="{StaticResource Table.List}" SelectionChanged="Lista_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <c:PersonChip Width="265" Margin="0,0,12,0" Initials="{Binding Iniciais}"
                                                      Title="{Binding Nome}" Subtitle="{Binding Email}" />
                                        <TextBlock Style="{StaticResource Cell}" Width="190" Text="{Binding Especialidade}" />
                                        <TextBlock Style="{StaticResource Cell}" Width="85" Text="{Binding Id}" />
                                        <TextBlock Style="{StaticResource Cell}" Width="65" Text="{Binding Eventos}" />
                                        <TextBlock Style="{StaticResource Text.Link}" Width="115" VerticalAlignment="Center" Text="Editar cadastro" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <c:Pager x:Name="Paginacao" />

                <!-- Reconheça quem compartilha -->
                <Border Style="{StaticResource Card}">
                    <c:SpacedStackPanel Spacing="20">
                        <c:SectionHeader Title="Reconheça quem compartilha" Subtitle="Certificado do palestrante selecionado" />
                        <DockPanel>
                            <Button x:Name="EmitirBotao" DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}"
                                    Content="Emitir certificado" Margin="20,0,0,0" VerticalAlignment="Center" Click="Emitir_Click" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="CertEvento" Style="{StaticResource Text.14}" FontWeight="SemiBold" />
                                <TextBlock x:Name="CertDetalhe" Style="{StaticResource Text.12}" Margin="0,5,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </c:SpacedStackPanel>
                </Border>
            </c:SpacedStackPanel>
        </DockPanel>
    </c:SpacedStackPanel>
</UserControl>
