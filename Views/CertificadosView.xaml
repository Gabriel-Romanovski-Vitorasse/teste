<UserControl x:Class="EloEventos.Views.CertificadosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             xmlns:c="clr-namespace:EloEventos.Controls">

    <!-- Tela montada a partir da estrutura do frame 27:20215 (posições e tamanhos do Figma).
         Os textos e o estilo do certificado foram aproximados: revisar com get_design_context. -->
    <c:SpacedStackPanel Spacing="24">

        <!-- Cabeçalho da página -->
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Baixar selecionado"
                    VerticalAlignment="Center" Margin="24,0,0,0" Click="Baixar_Click" />
            <StackPanel>
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="Cada encontro merece ser lembrado." />
                <TextBlock Style="{StaticResource Text.14}" Foreground="{StaticResource Brush.Muted}" Margin="0,6,0,0"
                           Text="Emita, confira e compartilhe os certificados de participantes e palestrantes." />
            </StackPanel>
        </DockPanel>

        <!-- Resumo -->
        <StackPanel Orientation="Horizontal">
            <c:StatusPill x:Name="ResumoEmitidos" Kind="Info" />
            <c:StatusPill x:Name="ResumoPendentes" Kind="Warning" Margin="12,0,0,0" />
            <c:StatusPill Kind="Neutral" Text="1 evento concluído" Margin="12,0,0,0" />
        </StackPanel>

        <!-- Emissões e prévia -->
        <DockPanel>
            <!-- Gestão de emissões -->
            <c:SpacedStackPanel DockPanel.Dock="Left" Width="500" Margin="0,0,24,0" Spacing="20">

                <Border Style="{StaticResource Card}">
                    <c:SpacedStackPanel Spacing="20">
                        <c:SectionHeader Title="Emitir certificado" Subtitle="Escolha o evento e quem será reconhecido" />
                        <c:Field Label="Evento concluído *">
                            <ComboBox Style="{StaticResource Select}" SelectedIndex="0">
                                <ComboBoxItem Content="Educação que transforma · EVT-005" />
                            </ComboBox>
                        </c:Field>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <c:Field Grid.Column="0" Label="Tipo *">
                                <ComboBox x:Name="CampoTipo" Style="{StaticResource Select}" SelectedIndex="0"
                                          SelectionChanged="Tipo_Changed">
                                    <ComboBoxItem Content="Participante" />
                                    <ComboBoxItem Content="Palestrante" />
                                </ComboBox>
                            </c:Field>
                            <c:Field Grid.Column="2" Label="Destinatário *">
                                <ComboBox x:Name="CampoDestinatario" Style="{StaticResource Select}" DisplayMemberPath="Destinatario"
                                          SelectionChanged="Destinatario_Changed" />
                            </c:Field>
                        </Grid>
                        <Button x:Name="BotaoEmitir" Style="{StaticResource Button.Primary}" Content="Emitir certificado"
                                Click="Emitir_Click" />
                        <TextBlock Style="{StaticResource Text.11}"
                                   Text="Disponível para quem teve presença confirmada no evento concluído." />
                    </c:SpacedStackPanel>
                </Border>

                <DockPanel>
                    <ComboBox x:Name="FiltroTipo" DockPanel.Dock="Right" Style="{StaticResource Select.Filter}"
                              Margin="12,0,0,0" SelectedIndex="0" SelectionChanged="Filtro_Changed">
                        <ComboBoxItem Content="Todos" />
                        <ComboBoxItem Content="Participantes" />
                        <ComboBoxItem Content="Palestrantes" />
                    </ComboBox>
                    <TextBox x:Name="Busca" Style="{StaticResource SearchBox}" Tag="Buscar por nome ou código"
                             TextChanged="Busca_Changed" />
                </DockPanel>

                <Border Style="{StaticResource Table}">
                    <StackPanel>
                        <Border Style="{StaticResource Table.Header}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,3,0,0">
                                <TextBlock Style="{StaticResource Text.TableHeader}" Width="195" Text="DESTINATÁRIO" />
                                <TextBlock Style="{StaticResource Text.TableHeader}" Width="95" Text="TIPO" />
                                <TextBlock Style="{StaticResource Text.TableHeader}" Width="130" Text="EMISSÃO" />
                            </StackPanel>
                        </Border>
                        <ListBox x:Name="Lista" Style="{StaticResource Table.List}" SelectionChanged="Lista_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Width="195" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Text.13}" FontWeight="SemiBold" Text="{Binding Destinatario}" />
                                            <TextBlock Style="{StaticResource Text.11}" Margin="0,3,0,0" Text="{Binding DestinatarioId}" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Cell}" Width="95" Text="{Binding Tipo}" />
                                        <Grid Width="130" VerticalAlignment="Center">
                                            <StackPanel x:Name="Emitido">
                                                <c:StatusPill Kind="Success" Text="Emitido" />
                                                <TextBlock Style="{StaticResource Text.11}" Margin="0,4,0,0" Text="{Binding EmitidoTexto}" />
                                            </StackPanel>
                                            <TextBlock x:Name="Pendente" Style="{StaticResource Text.13}" Visibility="Collapsed"
                                                       Text="{Binding SituacaoTexto}" />
                                        </Grid>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Emitido}" Value="False">
                                            <Setter TargetName="Emitido" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="Pendente" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <c:Pager x:Name="Paginacao" />
            </c:SpacedStackPanel>

            <!-- Prévia e validação -->
            <c:SpacedStackPanel Spacing="20">
                <DockPanel>
                    <c:StatusPill x:Name="PreviaStatus" DockPanel.Dock="Right" />
                    <TextBlock Style="{StaticResource Text.SectionTitle}" VerticalAlignment="Center" Text="Prévia do certificado" />
                </DockPanel>

                <!-- Certificado de participação (exportado como PNG em "Baixar certificado") -->
                <Border x:Name="CertificadoVisual" Style="{StaticResource Card}" Padding="20">
                    <Border BorderBrush="{StaticResource Brush.BrandSoft}" BorderThickness="2" CornerRadius="8"
                            Padding="34,24" Height="442">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top">
                                <Viewbox x:Name="Selo" DockPanel.Dock="Right" Width="36" Height="36" Visibility="Collapsed">
                                    <svgc:SvgViewbox x:Name="SeloSvg" Width="36" Height="36" />
                                </Viewbox>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource Brush.Brand}">
                                        <svgc:SvgViewbox Source="/Assets/Icons/calendar-days.svg" Width="20" Height="20" />
                                    </Border>
                                    <TextBlock Text="elo" Margin="10,0,0,0" FontSize="27" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Ink}" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource Text.12}" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Text="· Conecta Educação" />
                                </StackPanel>
                            </DockPanel>

                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Text.Base}" FontSize="9" LineHeight="13"
                                       Foreground="{StaticResource Brush.Muted}" TextAlignment="Center" x:Name="PreviaCodigo" />

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.Base}" FontSize="10.5" LineHeight="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Brand}" TextAlignment="Center" Text="CERTIFICADO" />
                                <TextBlock x:Name="PreviaTitulo" Style="{StaticResource Text.Base}" FontSize="28" LineHeight="41"
                                           TextAlignment="Center" Margin="0,5,0,0" />
                                <TextBlock Style="{StaticResource Text.12}" TextAlignment="Center" Margin="0,20,0,0" Text="Certificamos que" />
                                <TextBlock x:Name="PreviaNome" Style="{StaticResource Text.Base}" FontSize="26" LineHeight="38"
                                           FontWeight="SemiBold" Foreground="{StaticResource Brush.BrandDark}"
                                           TextAlignment="Center" Margin="0,12,0,0" />
                                <TextBlock x:Name="PreviaTexto" Style="{StaticResource Text.13}" Foreground="{StaticResource Brush.Muted}"
                                           TextAlignment="Center" Margin="40,12,40,0" />
                                <StackPanel Width="240" Margin="0,20,0,0">
                                    <TextBlock Text="Luiza Costa" FontSize="17" FontStyle="Italic" Foreground="{StaticResource Brush.Ink}"
                                               HorizontalAlignment="Center" />
                                    <Border Height="1" Width="200" Margin="0,6,0,0" Background="{StaticResource Brush.Border}" />
                                    <TextBlock Style="{StaticResource Text.Base}" FontSize="10.5" LineHeight="15"
                                               Foreground="{StaticResource Brush.Muted}" TextAlignment="Center" Margin="0,6,0,0"
                                               Text="Luiza Costa · Organização" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Border>

                <!-- Detalhes da emissão -->
                <Border Style="{StaticResource Card}">
                    <c:SpacedStackPanel Spacing="20">
                        <c:SectionHeader Title="Detalhes da emissão" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition /><ColumnDefinition Width="24" /><ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource Text.11}" Text="EVENTO" />
                                <TextBlock x:Name="DetalheEvento" Style="{StaticResource Text.13}" FontWeight="SemiBold" Margin="0,5,0,0" />
                                <TextBlock x:Name="DetalhePeriodo" Style="{StaticResource Text.12}" Margin="0,5,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Text.11}" Text="AUTENTICIDADE" />
                                <TextBlock x:Name="DetalheCodigo" Style="{StaticResource Text.13}" FontWeight="SemiBold" Margin="0,5,0,0" />
                                <TextBlock x:Name="DetalheEmissao" Style="{StaticResource Text.12}" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BotaoBaixar" Style="{StaticResource Button.Primary}" Content="Baixar certificado" Click="Baixar_Click" />
                            <Button x:Name="BotaoCopiar" Style="{StaticResource Button.Secondary}" Content="Copiar link de validação"
                                    Margin="12,0,0,0" Click="Copiar_Click" />
                        </StackPanel>
                    </c:SpacedStackPanel>
                </Border>

                <c:Notice x:Name="Aviso" Text="O link de validação permite que qualquer pessoa confira a autenticidade do certificado." />
            </c:SpacedStackPanel>
        </DockPanel>
    </c:SpacedStackPanel>
</UserControl>
