<UserControl x:Class="EloEventos.Views.ParticipantesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EloEventos.Controls">

    <c:SpacedStackPanel Spacing="24">

        <!-- Cabeçalho da página -->
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="+ Novo participante"
                    VerticalAlignment="Center" Margin="24,0,0,0" Click="Novo_Click" />
            <StackPanel>
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="Pessoas no centro de cada encontro." />
                <TextBlock Style="{StaticResource Text.14}" Foreground="{StaticResource Brush.Muted}" Margin="0,6,0,0"
                           Text="Mantenha os dados dos participantes organizados e acompanhe suas inscrições." />
            </StackPanel>
        </DockPanel>

        <!-- Resumo -->
        <StackPanel Orientation="Horizontal">
            <c:StatusPill x:Name="ResumoTotal" Kind="Info" Text="128 participantes" />
            <c:StatusPill Kind="Neutral" Text="12 instituições" Margin="12,0,0,0" />
            <c:StatusPill Kind="Success" Text="24 novos este mês" Margin="12,0,0,0" />
        </StackPanel>

        <!-- Diretório e cadastro -->
        <DockPanel>
            <!-- Edição de participante -->
            <c:SpacedStackPanel DockPanel.Dock="Right" Width="420" Margin="24,0,0,0" Spacing="20">
                <Border Style="{StaticResource Card}">
                    <c:SpacedStackPanel Spacing="20">
                        <c:SectionHeader x:Name="FormTitulo" Title="Cadastro do participante" Subtitle="Editando Ana Beatriz Lima" />
                        <c:Field Label="ID">
                            <TextBox x:Name="CampoId" Style="{StaticResource Input}" IsReadOnly="True" />
                        </c:Field>
                        <c:Field Label="Nome completo *">
                            <TextBox x:Name="CampoNome" Style="{StaticResource Input}" />
                        </c:Field>
                        <c:Field Label="CPF *">
                            <StackPanel>
                                <TextBox x:Name="CampoCpf" Style="{StaticResource Input}" Tag="000.000.000-00" />
                                <TextBlock Style="{StaticResource Text.11}" Margin="0,7,0,0"
                                           Text="Documento fictício, apenas para demonstração." />
                            </StackPanel>
                        </c:Field>
                        <c:Field Label="E-mail *">
                            <TextBox x:Name="CampoEmail" Style="{StaticResource Input}" />
                        </c:Field>
                        <c:Field Label="Instituição *">
                            <TextBox x:Name="CampoInstituicao" Style="{StaticResource Input}" />
                        </c:Field>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Secondary}" Content="Cancelar" Click="Cancelar_Click" />
                            <Button Style="{StaticResource Button.Primary}" Content="Salvar cadastro" Margin="12,0,0,0" Click="Salvar_Click" />
                        </StackPanel>
                        <TextBlock x:Name="Erro" Style="{StaticResource Text.12}" Foreground="{StaticResource Brush.Danger}"
                                   Visibility="Collapsed" />
                    </c:SpacedStackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <c:SpacedStackPanel Spacing="20">
                        <c:SectionHeader Title="Inscrições vinculadas" />
                        <c:SpacedStackPanel x:Name="InscricoesAna" Spacing="20">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.13}" FontWeight="SemiBold" Text="Conecta 2026: futuros da educação" />
                                <DockPanel Margin="0,8,0,0">
                                    <c:StatusPill DockPanel.Dock="Right" Kind="Warning" Text="Pendente" />
                                    <TextBlock Style="{StaticResource Text.11}" VerticalAlignment="Top" Text="INS-001 · 05/11/2026" />
                                </DockPanel>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.13}" FontWeight="SemiBold" Text="Educação que transforma" />
                                <TextBlock Style="{StaticResource Text.12}" Foreground="{StaticResource Brush.Success}" Margin="0,6,0,0"
                                           Text="Concluída · certificado emitido" />
                            </StackPanel>
                        </c:SpacedStackPanel>
                        <TextBlock x:Name="InscricoesResumo" Style="{StaticResource Text.13}" Foreground="{StaticResource Brush.Muted}"
                                   Visibility="Collapsed" />
                    </c:SpacedStackPanel>
                </Border>
            </c:SpacedStackPanel>

            <!-- Diretório -->
            <c:SpacedStackPanel Spacing="18">
                <DockPanel>
                    <ComboBox x:Name="FiltroInstituicao" DockPanel.Dock="Right" Style="{StaticResource Select.Filter}"
                              Margin="12,0,0,0" SelectionChanged="Filtro_Changed" />
                    <TextBox x:Name="Busca" Style="{StaticResource SearchBox}" Tag="Buscar por nome, e-mail ou CPF"
                             TextChanged="Busca_Changed" />
                </DockPanel>

                <Border Style="{StaticResource Table}">
                    <StackPanel>
                        <Border Style="{StaticResource Table.Header}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,3,0,0">
                                <TextBlock Style="{StaticResource Text.TableHeader}" Width="280" Text="PARTICIPANTE" />
                                <TextBlock Style="{StaticResource Text.TableHeader}" Width="185" Text="INSTITUIÇÃO" />
                                <TextBlock Style="{StaticResource Text.TableHeader}" Width="85" Text="ID" />
                                <TextBlock Style="{StaticResource Text.TableHeader}" Width="100" Text="INSCRIÇÕES" />
                            </StackPanel>
                        </Border>
                        <ListBox x:Name="Lista" Style="{StaticResource Table.List}" SelectionChanged="Lista_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <c:PersonChip Width="280" Margin="0,0,12,0" Initials="{Binding Iniciais}"
                                                      Title="{Binding Nome}" Subtitle="{Binding Email}" />
                                        <TextBlock Style="{StaticResource Cell}" Width="185" Text="{Binding Instituicao}" />
                                        <TextBlock Style="{StaticResource Cell}" Width="85" Text="{Binding Id}" />
                                        <TextBlock Style="{StaticResource Cell}" Width="100" Text="{Binding InscricoesTexto}" />
                                        <TextBlock Style="{StaticResource Text.Link}" Width="60" VerticalAlignment="Center" Text="Editar" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <c:Pager x:Name="Paginacao" />

                <c:Notice Text="Selecione um participante para editar seus dados. As inscrições permanecem vinculadas ao mesmo ID." />
            </c:SpacedStackPanel>
        </DockPanel>
    </c:SpacedStackPanel>
</UserControl>
