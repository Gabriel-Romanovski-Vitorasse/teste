<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
                    xmlns:c="clr-namespace:EloEventos.Controls">

    <!-- ===================== Texto ===================== -->
    <!-- line-height 1.45 do Figma aplicado como LineHeight fixo por tamanho -->
    <Style x:Key="Text.Base" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Inter}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Ink}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Text.11" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LineHeight" Value="15.95" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
    </Style>
    <Style x:Key="Text.12" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="17.4" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
    </Style>
    <Style x:Key="Text.13" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="18.85" />
    </Style>
    <Style x:Key="Text.14" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20.3" />
    </Style>
    <Style x:Key="Text.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.12}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Ink}" />
    </Style>
    <Style x:Key="Text.Link" TargetType="TextBlock" BasedOn="{StaticResource Text.12}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Brand}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextDecorations" Value="Underline" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Text.SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="LineHeight" Value="24.65" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Text.PageTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="LineHeight" Value="36" />
    </Style>
    <Style x:Key="Text.Stat" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="29" />
        <Setter Property="LineHeight" Value="42.05" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Text.TableHeader" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
        <Setter Property="LineStackingStrategy" Value="MaxHeight" />
        <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    <!-- ===================== Superfícies ===================== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding" Value="{StaticResource Pad.Card}" />
    </Style>

    <!-- ===================== Botões ===================== -->
    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Font.Inter}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Control}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.BrandDark}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.Brand}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Brand}" />
        <Setter Property="Foreground" Value="White" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.BrandDark}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.BrandDark}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Brand}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.BrandSoft}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.DangerSoft}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Botão sem moldura (links de texto, ícones clicáveis, linhas da tabela) -->
    <Style x:Key="Button.Bare" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Navegação principal ===================== -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="GroupName" Value="MainNav" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Inter}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Control}" Padding="16,6">
                        <TextBlock Text="{TemplateBinding Content}" LineHeight="28"
                                   LineStackingStrategy="BlockLineHeight" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Brush.Ink}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.BrandSoft}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.BrandDark}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Abas de texto (Todos os eventos 6 · Conferências 3 ...) -->
    <Style x:Key="TextTab" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource Font.Inter}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
        <Setter Property="Margin" Value="0,0,24,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <TextBlock Background="Transparent" Text="{TemplateBinding Content}" LineHeight="20.3"
                               LineStackingStrategy="BlockLineHeight" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Brush.Brand}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== Campos de formulário ===================== -->
    <SolidColorBrush x:Key="Brush.Placeholder" Color="{StaticResource Color.Ink}" />

    <Style x:Key="Input" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Inter}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Ink}" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Ink}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.Brand}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Control}" SnapsToDevicePixels="True">
                        <Grid Margin="{TemplateBinding Padding}">
                            <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Visibility="Collapsed"
                                       Margin="2,0" FontSize="13" Foreground="{StaticResource Brush.Placeholder}"
                                       TextWrapping="Wrap" IsHitTestVisible="False"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#C9D6D9" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.Brand}" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Input.Multiline" TargetType="TextBox" BasedOn="{StaticResource Input}">
        <Setter Property="MinHeight" Value="84" />
        <Setter Property="Padding" Value="10,12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AcceptsReturn" Value="True" />
    </Style>

    <!-- Campo de busca com ícone -->
    <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource Input}">
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <DockPanel>
                            <svgc:SvgViewbox DockPanel.Dock="Left" Source="/Assets/Icons/search.svg"
                                             Width="18" Height="18" Margin="0,0,10,0" />
                            <Grid VerticalAlignment="Center">
                                <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Margin="2,0" FontSize="13"
                                           Foreground="{StaticResource Brush.Muted}" IsHitTestVisible="False"
                                           Visibility="Collapsed" TextTrimming="CharacterEllipsis" />
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                            </Grid>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.Brand}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Seleção (ComboBox) com chevron-down do Figma -->
    <Style x:Key="SelectItem" TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource Font.Inter}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Ink}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="6">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfaceMuted}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.BrandSoft}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.BrandDark}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Select" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Inter}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Ink}" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SelectItem}" />
        <!-- Tag = distância entre o texto e o chevron -->
        <Setter Property="Tag">
            <Setter.Value>
                <Thickness>10,0,0,0</Thickness>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Chrome"
                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="1" CornerRadius="{StaticResource Radius.Control}"
                                            SnapsToDevicePixels="True" />
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#C9D6D9" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.Brand}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <DockPanel Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                            <svgc:SvgViewbox DockPanel.Dock="Right" Source="/Assets/Icons/chevron-down.svg"
                                             Width="14" Height="14"
                                             Margin="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                        </DockPanel>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                            <Border MinWidth="{TemplateBinding ActualWidth}" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="1" CornerRadius="{StaticResource Radius.Control}"
                                    Padding="4" Margin="0,4,0,8" MaxHeight="280">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.10" Color="#20363D" />
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Variante compacta (filtro ao lado da busca: gap 18) -->
    <Style x:Key="Select.Filter" TargetType="ComboBox" BasedOn="{StaticResource Select}">
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Tag">
            <Setter.Value>
                <Thickness>18,0,0,0</Thickness>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Componentes ===================== -->
    <Style TargetType="c:StatusPill">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceMuted}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:StatusPill">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Pill}"
                            Padding="10,5">
                        <TextBlock Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}"
                                   FontFamily="{StaticResource Font.Inter}" FontSize="12" FontWeight="SemiBold"
                                   LineHeight="17.4" LineStackingStrategy="BlockLineHeight" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Kind" Value="Success">
                <Setter Property="Background" Value="{StaticResource Brush.SuccessSoft}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
            </Trigger>
            <Trigger Property="Kind" Value="Warning">
                <Setter Property="Background" Value="{StaticResource Brush.WarningSoft}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
            </Trigger>
            <Trigger Property="Kind" Value="Info">
                <Setter Property="Background" Value="{StaticResource Brush.BrandSoft}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.BrandDark}" />
            </Trigger>
            <Trigger Property="Kind" Value="Danger">
                <Setter Property="Background" Value="{StaticResource Brush.DangerSoft}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="c:Notice">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:Notice">
                    <Border Background="{StaticResource Brush.BrandSoft}" CornerRadius="{StaticResource Radius.Control}"
                            Padding="14">
                        <DockPanel>
                            <svgc:SvgViewbox DockPanel.Dock="Left" Source="/Assets/Icons/info.svg"
                                             Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Top" />
                            <TextBlock Text="{TemplateBinding Text}" Style="{StaticResource Text.12}"
                                       Foreground="{StaticResource Brush.BrandDark}" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:Avatar">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Background" Value="{StaticResource Brush.BrandSoft}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.BrandDark}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:Avatar">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static c:HalfCornerConverter.Instance}}">
                        <TextBlock Text="{TemplateBinding Initials}" Foreground="{TemplateBinding Foreground}"
                                   FontFamily="{StaticResource Font.Inter}" FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:PersonChip">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:PersonChip">
                    <DockPanel>
                        <c:Avatar DockPanel.Dock="Left" Initials="{TemplateBinding Initials}" Margin="0,0,12,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource Text.13}"
                                       FontWeight="SemiBold" Margin="0,0,0,3" />
                            <TextBlock Text="{TemplateBinding Subtitle}" Style="{StaticResource Text.11}" />
                        </StackPanel>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rótulo + campo (gap 7) -->
    <Style TargetType="c:Field">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:Field">
                    <StackPanel>
                        <TextBlock Text="{TemplateBinding Label}" Style="{StaticResource Text.Label}" Margin="0,0,0,7" />
                        <ContentPresenter />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Título de seção de card: título 17 + subtítulo 12 (gap 4) -->
    <Style TargetType="c:SectionHeader">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:SectionHeader">
                    <StackPanel>
                        <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource Text.SectionTitle}" />
                        <TextBlock x:Name="Sub" Text="{TemplateBinding Subtitle}" Style="{StaticResource Text.12}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Subtitle" Value="{x:Null}">
                            <Setter TargetName="Sub" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Indicador (card de métrica) -->
    <Style TargetType="c:StatCard">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:StatCard">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{TemplateBinding Label}" Style="{StaticResource Text.13}"
                                       Foreground="{StaticResource Brush.Muted}" Margin="0,0,0,8" />
                            <TextBlock Text="{TemplateBinding Value}" Style="{StaticResource Text.Stat}" Margin="0,0,0,8" />
                            <TextBlock Text="{TemplateBinding Caption}" Style="{StaticResource Text.12}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Tabela ===================== -->
    <Style x:Key="Table" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Table}" />
    </Style>
    <Style x:Key="Table.Header" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceMuted}" />
        <Setter Property="CornerRadius" Value="10,10,0,0" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="16,0" />
    </Style>
    <Style x:Key="Table.Row" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="MinHeight" Value="77" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FAFCFC" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Célula: largura fixa definida na view; gap de 12 entre colunas -->
    <Style x:Key="Cell" TargetType="TextBlock" BasedOn="{StaticResource Text.13}">
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Tabela com seleção de linha (diretórios com edição ao lado) -->
    <Style x:Key="Table.SelectableRow" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="0,1,0,0" MinHeight="77" Padding="16,14">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#FAFCFC" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.BrandSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Table.List" TargetType="ListBox">
        <Setter Property="ItemContainerStyle" Value="{StaticResource Table.SelectableRow}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Paginação -->
    <Style x:Key="PageCurrent" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.BrandSoft}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
    </Style>

    <Style TargetType="c:Pager">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:Pager">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Bare}" ToolTip="Página anterior" IsEnabled="False">
                                <svgc:SvgViewbox Source="/Assets/Icons/chevron-left.svg" Width="16" Height="16" />
                            </Button>
                            <Border Style="{StaticResource PageCurrent}" Margin="10,0">
                                <TextBlock Text="1" FontFamily="{StaticResource Font.Inter}" FontSize="12"
                                           Foreground="{StaticResource Brush.Brand}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Button Style="{StaticResource Button.Bare}" ToolTip="Próxima página">
                                <svgc:SvgViewbox Source="/Assets/Icons/chevron-right.svg" Width="16" Height="16" />
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{TemplateBinding Summary}" Style="{StaticResource Text.12}" VerticalAlignment="Center" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cartão de opção (○ Pessoa Física / ● Pessoa Jurídica) -->
    <Style x:Key="OptionCard" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource Font.Inter}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Ink}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource Radius.Control}" Padding="12">
                        <TextBlock LineHeight="17.4" LineStackingStrategy="BlockLineHeight">
                            <Run x:Name="Glyph" Text="○" /><Run Text=" " /><Run Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Glyph" Property="Text" Value="●" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#C9D6D9" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.BrandSoft}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Brand}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.BrandDark}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Bloco alternativo cinza dentro de formulários -->
    <Style x:Key="AltBlock" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceMuted}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="Padding" Value="16" />
    </Style>

</ResourceDictionary>
